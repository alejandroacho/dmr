# Custom vLLM image for GB10 Blackwell (sm_121).
#
# NOTE: Swapping PyTorch on top of a pre-built vLLM breaks ABI compatibility
# (_C.abi3.so is compiled against the bundled PyTorch version).
# The only correct way to get native sm_121 support is to build vLLM from
# source against a PyTorch that includes sm_121 in its arch list.
#
# Currently no public PyTorch wheel (nightly or stable) includes sm_121.
# Until one is available, this file simply re-tags the upstream image.
# GB10 falls back to PTX JIT via compute_120, which is cached after the
# first inference and has negligible steady-state overhead.
#
# Build:
#   docker build -f Dockerfile.vllm -t blackwell-vllm:latest .
# Equivalent shortcut (no build needed):
#   docker tag vllm/vllm-openai:cu130-nightly blackwell-vllm:latest

FROM vllm/vllm-openai:cu130-nightly
