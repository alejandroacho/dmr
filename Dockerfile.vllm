# Custom vLLM image that adds native sm_121 (GB10 Blackwell) support.
#
# The official vllm/vllm-openai:cu130-nightly ships PyTorch compiled up to
# sm_120. GB10 is sm_121, so PyTorch falls back to PTX JIT (compute_120),
# which recompiles Triton kernels on every cold start.
#
# This image installs the latest PyTorch nightly wheel compiled with sm_121,
# eliminating the "cuda capability 12.1 is not supported" warning and making
# the first-inference latency equivalent to any other arch.
#
# Build:
#   docker build -f Dockerfile.vllm -t vllm-blackwell:latest .
# Use in docker-compose: replace `image: vllm/vllm-openai:cu130-nightly`
#                        with    `image: vllm-blackwell:latest`

FROM vllm/vllm-openai:cu130-nightly

# Install PyTorch nightly wheel with Blackwell (sm_121) support.
# The nightly index for cu130 includes sm_121 starting from 2025-12-01 builds.
RUN pip install --no-cache-dir --pre \
      torch \
      --index-url https://download.pytorch.org/whl/nightly/cu130

# Verify sm_121 is in the compiled arch list (build-time sanity check).
RUN python3 -c "
import torch
archs = torch.cuda.get_arch_list()
print('Compiled archs:', archs)
assert 'sm_121' in archs or 'compute_121' in archs, \
    f'sm_121 not found in {archs}. Use a newer nightly build.'
print('OK: sm_121 supported natively.')
"
