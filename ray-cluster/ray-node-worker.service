[Unit]
Description=Ray Worker Node (vLLM Inference Cluster)
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStartPre=-/usr/bin/docker stop ray-node-worker
ExecStartPre=-/usr/bin/docker rm ray-node-worker
ExecStart=/bin/bash /home/alejandroacho/Server/ray-cluster/reset_ray_node.sh --worker 192.168.200.12
ExecStop=/usr/bin/docker stop ray-node-worker
Restart=on-failure
RestartSec=30s
TimeoutStartSec=120s
TimeoutStopSec=60s

[Install]
WantedBy=multi-user.target
