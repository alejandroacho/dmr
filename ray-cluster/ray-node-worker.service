[Unit]
Description=Ray Worker Node (vLLM Inference Cluster)
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
# reset_ray_node.sh already stops & removes any stale ray-node-* container,
# so we don't need ExecStartPre — those just killed manually-started containers.
ExecStart=/bin/bash /home/alejandroacho/reset_ray_node.sh --worker 192.168.200.12
ExecStop=-/usr/bin/docker stop ray-node-worker
Restart=on-failure
RestartSec=60s
TimeoutStartSec=180s
TimeoutStopSec=60s

[Install]
WantedBy=multi-user.target
