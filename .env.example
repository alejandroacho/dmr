# ──────────────────────────────────────────
#  Blackwell Smart Gateway — .env.example
#  Copy to .env and adjust per node.
# ──────────────────────────────────────────

GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000

# Local model path on NVMe
MODELS_PATH=/mnt/nvme_data/models

# Total system RAM (determines swap strategy)
SYSTEM_RAM_GB=218

# Timeouts
SWAP_TIMEOUT_S=30
VRAM_POLL_INTERVAL_S=2.0
VRAM_SAFETY_MARGIN_MB=4096
RETRY_AFTER_SECONDS=5
RETRY_LOG_INTERVAL_S=10

# Request buffer during swaps
LONG_POLLING_ENABLED=true
LONG_POLLING_TIMEOUT_S=30
MAX_QUEUE_SIZE=200

# Ray cluster — IP of the head node (vllm serve runs here with --network host)
RAY_HEAD_HOST=192.168.200.12

# ── Media node (node 3) ──
# Address of the media node's adapter as seen from *outside* the node. Used for
# MEDIA_PUBLIC_URL (base URL of generated-asset links) and as the default for
# MEDIA_NODE_HOST. Only address to change when the node moves networks.
MEDIA_NODE_IP=192.168.8.147
MEDIA_NODE_HOST=192.168.8.147
MEDIA_NODE_PORT=8010
# Full URL used by media_node.py (compose sets this to http://media-node:8010)
# MEDIA_NODE_URL=http://192.168.8.147:8010
# Public base URL of the gateway (used for media asset links)
# GATEWAY_PUBLIC_URL=http://192.168.1.125:8000

# Docker
DOCKER_SOCKET=unix:///var/run/docker.sock
DOCKER_NETWORK=blackwell-gateway_blackwell_net
