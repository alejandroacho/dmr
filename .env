# ──────────────────────────────────────────
#  Blackwell Smart Gateway — Default .env
# ──────────────────────────────────────────

GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000

# Local model path on NVMe
MODELS_PATH=/mnt/nvme_data/models

# Total system RAM (determines swap strategy)
SYSTEM_RAM_GB=218

# Timeouts
SWAP_TIMEOUT_S=30
VRAM_POLL_INTERVAL_S=2.0
VRAM_SAFETY_MARGIN_MB=4096
RETRY_AFTER_SECONDS=5

# How often retry/wait messages are logged (avoids log spam)
RETRY_LOG_INTERVAL_S=10

# Request buffer during swaps
LONG_POLLING_ENABLED=true
LONG_POLLING_TIMEOUT_S=30
MAX_QUEUE_SIZE=200

# ── Media node (node 3) ──
# Its address as seen from *outside* the node. Used for MEDIA_PUBLIC_URL (the
# base URL of generated-asset links, which clients must be able to resolve) and
# as the default for MEDIA_NODE_HOST. Inside the media profile everything else
# reaches the adapter by container name, so this is the only address to change
# when the node moves from WiFi to its wired 192.168.1.x address.
MEDIA_NODE_IP=192.168.8.147

# Docker
DOCKER_SOCKET=unix:///var/run/docker.sock
DOCKER_NETWORK=blackwell-gateway_blackwell_net
